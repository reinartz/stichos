{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stichos:schemas:fixture:1",
  "title": "stichos corpus fixture manifest (C9)",
  "description": "One manifest per corpus fixture at corpus/manifests/<id>.json. Blobs are gitignored; canonical addressing is sha256 via the external object store (corpus/PLAN.md §6).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "source",
    "format",
    "categories",
    "features",
    "reference_text",
    "expected",
    "render",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "description": "Manifest schema version; integer starting at 1 (C9 §3).",
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "description": "Kebab-case fixture id: <cat>-<format>-<nnn>, e.g. merged-cells-docx-001.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-(docx|xlsx|pptx|odt|ods|odp|pdf)-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": ["generated", "curated"]
    },
    "generator": {
      "description": "Required iff source=generated (HAR-02 generator identity).",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "origin": {
      "description": "Required iff source=curated; license review verdict per corpus/PLAN.md §5 goes in notes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license"],
      "properties": {
        "source": {
          "description": "Upstream collection/project the fixture was taken from.",
          "type": "string",
          "minLength": 1
        },
        "license": {
          "description": "SPDX id or explicit note, e.g. 'MPL-2.0', 'CC0-1.0', 'PD-US', 'unverified'.",
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "format": {
      "description": "Container format. pdf is allowed only for curated pdf-external fixtures (XFA etc.); Phase-0 generated corpus has no pdf inputs.",
      "type": "string",
      "enum": ["docx", "xlsx", "pptx", "odt", "ods", "odp", "pdf"]
    },
    "categories": {
      "description": "Category ids from corpus/PLAN.md §2 taxonomy.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "features": {
      "description": "Expected element counts by namespaced key, e.g. {\"w:tbl\": 3}. Exact-match semantics per C9 §6. Empty object allowed (corrupt/* reserved fixtures).",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9]+:[A-Za-z0-9]+$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "reference_text": {
      "description": "Path to golden reference text for F1 (C9 §7); null for hostile/reserved fixtures with no text truth.",
      "type": ["string", "null"],
      "pattern": "^corpus/reference/[a-z0-9]+(?:-[a-z0-9]+)*\\.txt$"
    },
    "expected": {
      "description": "Expected page-count range; nulls until measured as goldens (HAR-05).",
      "type": "object",
      "additionalProperties": false,
      "required": ["page_count_min", "page_count_max"],
      "properties": {
        "page_count_min": { "type": ["integer", "null"], "minimum": 1 },
        "page_count_max": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "render": {
      "description": "Render matrix for goldens. engines: ids like 'soffice', 'pandoc', 'pdftoppm' (C5 engine ids). Empty arrays allowed for reserved/reserved-corrupt fixtures.",
      "type": "object",
      "additionalProperties": false,
      "required": ["dpis", "engines"],
      "properties": {
        "dpis": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "engines": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "notes": {
      "description": "Free text; curated ingest MUST record the PLAN §5 license verdict here.",
      "type": "string"
    },
    "sha256": {
      "description": "sha256 of fixture bytes; null until the blob exists and is hashed.",
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source": { "const": "generated" } },
        "required": ["source"]
      },
      "then": {
        "required": ["generator"],
        "properties": { "format": { "enum": ["docx", "xlsx", "pptx", "odt", "ods", "odp"] } }
      }
    },
    {
      "if": {
        "properties": { "source": { "const": "curated" } },
        "required": ["source"]
      },
      "then": {
        "required": ["origin"]
      }
    },
    {
      "if": {
        "properties": { "format": { "const": "pdf" } },
        "required": ["format"]
      },
      "then": {
        "properties": { "source": { "const": "curated" } }
      }
    }
  ]
}
